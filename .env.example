# ==============================================================================
# AI人脈コンシェルジュ — 環境変数設定テンプレート (.env.example)
# ※ 本ファイルに実際のAPIキーや機密情報を入力してコミットしないでください。
# ==============================================================================

# --- アプリケーション基本設定 ---
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_API_URL=http://localhost:8000

# --- Supabase / PostgreSQL ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- AI アダプター（モデルプロバイダー） ---
# 必要に応じて利用するキーを設定（固定の単一プロバイダーには依存しません）
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- 名刺OCR / クラウドビジョン ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-credentials.json

# --- Zoom 連携 (P5フェーズ用) ---
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-webhook-secret-token

# --- Google OAuth (Calendar / Meet / Contacts) (P5フェーズ用) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- 外部議事録ボット (P5/保留事項) ---
RECALL_AI_API_KEY=your-recall-ai-key-if-used

# --- 原価管理・予算ガードレール ---
DEFAULT_MONTHLY_BUDGET_JPY=4980
BUDGET_WARNING_THRESHOLD=0.8
ECO_MODE_HARD_LIMIT=1.0
